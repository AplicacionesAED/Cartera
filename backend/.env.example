NODE_ENV=development
PORT=3011
CORS_ORIGIN=http://localhost:5183
FRONTEND_URL=http://localhost:5183

# Alternativa: una sola DATABASE_URL=postgres://usuario:clave@host:puerto/base (tiene prioridad sobre las PG*)
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=cartera_aed_v2

JWT_SECRET=

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOMBRE=

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_BASE=https://www.zohoapis.com/crm/v2
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com

EXCEL_PASSWORD=

# Proyecto Oliv (CRM HubSpot, ver utils/hubspotClient.js) -- token estático
# de Private App (Settings → Integrations → Private Apps en HubSpot), sin
# OAuth de por medio. HUBSPOT_API_BASE solo si no es el estándar.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE=https://api.hubapi.com

# Solo lectura -- base de datos de Centro-Aplicaciones-Comerciales-AED (el
# Cotizador de Cuotas), para traer el plan de pago de la cotización aceptada
# de un negocio de Oliv (tabla `quotes`, join por `deal_id` = hubspot_id).
# Mismo valor que DATABASE_URL en Centro-Aplicaciones-Comerciales-AED/.env.
CENTRO_APLICACIONES_DATABASE_URL=

# Llave para la carga automática diaria de los Excel de la fiduciaria (n8n,
# ~12:00 hora de Colombia) en POST /api/fiducia/upload, enviada en la cabecera
# `X-API-Key`. Mínimo 32 caracteres; si queda vacía esa vía está deshabilitada
# (la subida manual con sesión sigue funcionando). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRACION_API_KEY=

# =====================================================================
# EJEMPLO PARA PRODUCCIÓN (Coolify) -- copiar y pegar, reemplazando <...>
# Runtime del recurso Cartera. PORT y NODE_ENV los fija el Dockerfile.
# Build args (aparte, al compilar): VITE_API_BASE_URL=/cartera/api  y  VITE_BASE_PATH=/cartera/
# Gateway (Plataforma AED): CARTERA_UPSTREAM=<dominio-publico-de-cartera-sin-https>
# =====================================================================
# CORS_ORIGIN=https://<dominio-del-gateway>
# DATABASE_URL=postgres://postgres:<clave>@72.62.100.53:5440/postgres
# JWT_SECRET=<64-hex-nuevo>
# INTEGRACION_API_KEY=<64-hex-nuevo>
# ZOHO_CLIENT_ID=<...>
# ZOHO_CLIENT_SECRET=<...>
# ZOHO_REFRESH_TOKEN=<...>
# HUBSPOT_ACCESS_TOKEN=<...>
# EXCEL_PASSWORD=<...>
# CENTRO_APLICACIONES_DATABASE_URL=<postgres://usuario:clave@host:5434/base>
